{
  "name": "gridzone",
  "version": "1.0.0",
  "private": true,
  "description": "GridZone - Bomberman battle royale with instant on-chain USDC settlement on Monad",
  "scripts": {
    "postinstall": "npm --prefix server install --omit=dev",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix server install --omit=dev",
    "start": "cd server && node src/index.js",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "abis": "node contracts/gen-abis.mjs"
  },
  "devDependencies": {
    "concurrently": "9.1.0"
  }
}
