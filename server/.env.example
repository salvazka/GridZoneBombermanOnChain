# Contract owner key: opens matches and funds the relayer pool. TESTNET ONLY.
OWNER_PRIVATE_KEY=0x...

CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPLORER_BASE=https://testnet.monadscan.com

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Relayer pool. One key is bound per match (PRD 5.3); raise for a public demo.
RELAYER_COUNT=8
RELAYER_SEED=change-me-relayer-seed
BOT_SEED=change-me-bot-seed

# Optional overrides. Contract addresses default to contracts/deployments/<chainId>.json
# ARENA_ADDRESS=0x...
# USDC_ADDRESS=0x...
